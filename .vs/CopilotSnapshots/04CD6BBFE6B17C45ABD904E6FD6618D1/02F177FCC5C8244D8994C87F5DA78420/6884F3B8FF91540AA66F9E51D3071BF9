<%@ Page Title="Manage Notes" Language="C#" MasterPageFile="~/Masterpages/Admin.Master" AutoEventWireup="true" CodeBehind="ManageNotes.aspx.cs" Inherits="Aarambha.Admin.ManageNotes" %>

<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
    <h3>Manage Notes</h3>
    <asp:Literal ID="ltAlert" runat="server"></asp:Literal>

    <div class="card p-3 mb-3">
        <h5>Add Note</h5>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ddlSubject">Subject</label>
                    <asp:DropDownList ID="ddlSubject" runat="server" CssClass="form-control"></asp:DropDownList>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="txtTitle">Title</label>
                    <asp:TextBox ID="txtTitle" runat="server" CssClass="form-control" placeholder="Note Title" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label for="txtContent">Content (HTML)</label>
                    <asp:TextBox ID="txtContent" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="5" placeholder="Enter note content..." />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="fuPDF">PDF Upload (optional)</label>
                    <asp:FileUpload ID="fuPDF" runat="server" accept=".pdf" CssClass="form-control" />
                </div>
                <div class="col-md-6 d-flex align-items-end mb-3">
                    <asp:Button ID="btnAdd" runat="server" Text="Create Note" CssClass="btn btn-primary" OnClick="btnAdd_Click" />
                </div>
            </div>

    </div>

    <asp:GridView ID="gvNotes" runat="server" CssClass="table table-hover" AutoGenerateColumns="false" OnRowCommand="gvNotes_RowCommand">
        <Columns>
            <asp:BoundField DataField="Title" HeaderText="Title" />
            <asp:TemplateField HeaderText="Subject">
                <ItemTemplate>
                    <%# (new Aarambha.BLL.SubjectBLL()).GetById(Convert.ToInt32(Eval("SubjectID"))).SubjectName %>
                </ItemTemplate>
            </asp:TemplateField>
            <asp:TemplateField HeaderText="Action">
                <ItemTemplate>
                    <div class="btn-group" role="group">
                        <asp:LinkButton ID="btnPreview" runat="server" CommandName="Preview" CommandArgument='<%# Eval("NoteID") %>' CssClass="btn btn-sm btn-info">Preview</asp:LinkButton>
                        <asp:LinkButton ID="btnDelete" runat="server" CommandName="DeleteNote" CommandArgument='<%# Eval("NoteID") %>' CssClass="btn btn-sm btn-danger" OnClientClick="return confirm('Are you sure you want to delete this note?');">Delete</asp:LinkButton>
                    </div>
                </ItemTemplate>
            </asp:TemplateField>
        </Columns>
    </asp:GridView>

    <!-- Preview Modal -->
    <div class="modal fade" id="notePreviewModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title"><asp:Literal ID="ltModalTitle" runat="server"></asp:Literal></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <asp:Literal ID="ltModalBody" runat="server"></asp:Literal>
            <div class="mt-3"><asp:Literal ID="ltModalResources" runat="server"></asp:Literal></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
</asp:Content>