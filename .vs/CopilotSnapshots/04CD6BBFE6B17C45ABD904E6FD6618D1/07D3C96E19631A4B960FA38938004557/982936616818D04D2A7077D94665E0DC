<%@ Page Title="" Language="C#" MasterPageFile="~/Masterpages/Site.Master" AutoEventWireup="true" CodeBehind="Default.aspx.cs" Inherits="Aarambha.Pages.Default" %>
<asp:Content ID="Content1" ContentPlaceHolderID="TitleContent" runat="server">Home</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" runat="server">

    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <span class="hero-badge">🎓 Grade 8 &middot; Sanskar School</span>
                    <h1 class="display-4 fw-bold">Learn. Practice. <span class="text-gradient">Achieve.</span></h1>
                    <p class="lead text-muted">Your Grade 8 learning portal for notes, resources, quizzes and school announcements, all in one place.</p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <asp:HyperLink runat="server" CssClass="btn btn-primary btn-lg px-4" NavigateUrl="~/Account/Register.aspx">Get Started</asp:HyperLink>
                        <asp:HyperLink runat="server" CssClass="btn btn-outline-primary btn-lg px-4" NavigateUrl="~/Account/Login.aspx">Login</asp:HyperLink>
                    </div>
                </div>
                <div class="col-lg-6 text-center">
                    <img class="hero-img" src="<%= ResolveUrl("~/Content/images/hero.svg") %>" alt="Student learning on a laptop" />
                </div>
            </div>
        </div>
    </section>

    <section class="container my-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Featured Subjects</h2>
            <p class="text-muted">A taste of what you'll find on Aarambha</p>
        </div>
        <div class="row g-4">
            <asp:Repeater ID="rptFeaturedSubjects" runat="server">
                <ItemTemplate>
                    <div class="col-md-4 col-sm-6">
                        <div class="subject-card">
                            <img src='<%# ResolveUrl(Aarambha.Helpers.UiHelper.SubjectImage(Eval("SubjectName"))) %>' alt="" />
                            <h5><%# Eval("SubjectName") %></h5>
                            <p class="text-muted small mb-0"><%# Eval("Description") %></p>
                        </div>
                    </div>
                </ItemTemplate>
            </asp:Repeater>
        </div>
        <div class="text-center mt-4">
            <asp:HyperLink runat="server" CssClass="btn btn-outline-primary px-4" NavigateUrl="~/Pages/Subjects.aspx">View All Subjects</asp:HyperLink>
        </div>
    </section>

    <section class="container my-5">
        <div class="row g-4">
            <div class="col-md-3 col-sm-6">
                <div class="feature-card text-center">
                    <div class="feature-icon">📘</div>
                    <h5>Study Notes</h5>
                    <p class="text-muted small mb-0">Read subject notes and download PDF materials anytime.</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="feature-card text-center">
                    <div class="feature-icon">📝</div>
                    <h5>Interactive Quizzes</h5>
                    <p class="text-muted small mb-0">Test your understanding with subject-based quizzes.</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="feature-card text-center">
                    <div class="feature-icon">📊</div>
                    <h5>Track Your Progress</h5>
                    <p class="text-muted small mb-0">Review your quiz scores and see how you're improving.</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="feature-card text-center">
                    <div class="feature-icon">📣</div>
                    <h5>School Announcements</h5>
                    <p class="text-muted small mb-0">Stay updated with the latest news from your teachers.</p>
                </div>
            </div>
        </div>
    </section>

</asp:Content>