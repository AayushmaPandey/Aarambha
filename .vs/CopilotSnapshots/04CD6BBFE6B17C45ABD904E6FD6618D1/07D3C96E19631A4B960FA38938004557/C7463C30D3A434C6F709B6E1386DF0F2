
<%@ Page Title="Manage Quizzes" Language="C#" MasterPageFile="~/Masterpages/Admin.Master" AutoEventWireup="true" CodeBehind="ManageQuiz.aspx.cs" Inherits="Aarambha.Admin.ManageQuiz" %>

<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
    <h3>Manage Quizzes</h3>
    <asp:Literal ID="ltAlert" runat="server"></asp:Literal>

    <div class="card p-3 mb-3">
        <h5>Add Quiz</h5>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="txtQuizTitle">Quiz Title</label>
                    <asp:TextBox ID="txtQuizTitle" runat="server" CssClass="form-control" placeholder="Quiz Title" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="ddlSubject">Subject</label>
                    <asp:DropDownList ID="ddlSubject" runat="server" CssClass="form-control"></asp:DropDownList>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="txtDuration">Duration (min)</label>
                    <asp:TextBox ID="txtDuration" runat="server" CssClass="form-control" TextMode="Number" placeholder="Duration (min)" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <asp:Button ID="btnAdd" runat="server" Text="Create Quiz" CssClass="btn btn-primary" OnClick="btnAdd_Click" />
                </div>
            </div>
        </form>
    </div>

    <h5 class="mt-4">Quizzes</h5>
    <asp:GridView ID="gvQuizzes" runat="server" CssClass="table table-hover" AutoGenerateColumns="false" OnRowCommand="gvQuizzes_RowCommand">
        <Columns>
            <asp:TemplateField HeaderText="Title">
                <ItemTemplate>
                    <strong><%# Eval("QuizTitle") %></strong>
                </ItemTemplate>
            </asp:TemplateField>
            <asp:TemplateField HeaderText="Subject">
                <ItemTemplate>
                    <%# (new Aarambha.BLL.SubjectBLL()).GetById(Convert.ToInt32(Eval("SubjectID"))).SubjectName %>
                </ItemTemplate>
            </asp:TemplateField>
            <asp:BoundField DataField="DurationMinutes" HeaderText="Duration (min)" />
            <asp:TemplateField HeaderText="Action">
                <ItemTemplate>
                    <div class="btn-group" role="group">
                        <asp:LinkButton ID="btnQuestions" runat="server" CommandName="Manage" CommandArgument='<%# Eval("QuizID") %>' CssClass="btn btn-sm btn-info">Questions</asp:LinkButton>
                        <asp:LinkButton ID="btnDelete" runat="server" CommandName="Delete" CommandArgument='<%# Eval("QuizID") %>' CssClass="btn btn-sm btn-danger" OnClientClick="return confirm('Are you sure you want to delete this quiz?');">Delete</asp:LinkButton>
                    </div>
                </ItemTemplate>
            </asp:TemplateField>
        </Columns>
    </asp:GridView>

    <div id="questionPanel" runat="server" visible="false" class="card p-3 mt-3">
        <h5>Questions for: <asp:Literal ID="ltEditQuiz" runat="server"></asp:Literal></h5>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label for="txtQuestion">New Question</label>
                    <asp:TextBox ID="txtQuestion" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="3" placeholder="Question text..." />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="ddlQuestionType">Question Type</label>
                    <asp:DropDownList ID="ddlQuestionType" runat="server" CssClass="form-control">
                        <asp:ListItem Value="SingleChoice">Single Choice</asp:ListItem>
                        <asp:ListItem Value="MultipleChoice">Multiple Choice</asp:ListItem>
                        <asp:ListItem Value="TrueFalse">True / False</asp:ListItem>
                    </asp:DropDownList>
                </div>
                <div class="col-md-8 mb-3">
                    <label>Options (mark correct)</label>
                    <div class="input-group mb-2">
                        <div class="input-group-text"><asp:CheckBox ID="chkOpt1" runat="server" /></div>
                        <asp:TextBox ID="txtOpt1" runat="server" CssClass="form-control" placeholder="Option 1" />
                    </div>
                    <div class="input-group mb-2">
                        <div class="input-group-text"><asp:CheckBox ID="chkOpt2" runat="server" /></div>
                        <asp:TextBox ID="txtOpt2" runat="server" CssClass="form-control" placeholder="Option 2" />
                    </div>
                    <div class="input-group mb-2">
                        <div class="input-group-text"><asp:CheckBox ID="chkOpt3" runat="server" /></div>
                        <asp:TextBox ID="txtOpt3" runat="server" CssClass="form-control" placeholder="Option 3 (optional)" />
                    </div>
                    <div class="input-group mb-2">
                        <div class="input-group-text"><asp:CheckBox ID="chkOpt4" runat="server" /></div>
                        <asp:TextBox ID="txtOpt4" runat="server" CssClass="form-control" placeholder="Option 4 (optional)" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-2 mb-3">
                    <asp:Button ID="btnAddQuestion" runat="server" Text="Add Question" CssClass="btn btn-primary" OnClick="btnAddQuestion_Click" />
                </div>
                <div class="col-md-10 mb-3">
                    <asp:Button ID="btnBackQuizzes" runat="server" Text="Back to Quizzes" CssClass="btn btn-secondary" OnClick="btnBackQuizzes_Click" />
                </div>
            </div>
        <div class="mt-3">
            <!-- existing questions list from code-behind will render here if implemented -->
        </div>
    </div>
</asp:Content>